# REVERSE AI 2.0 Environment Configuration
REVERSE_AI_ENV=production
REVERSE_AI_DEBUG=false
REVERSE_AI_RATE_LIMIT=120

# Upload limit in bytes (default: 52428800 = 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800

